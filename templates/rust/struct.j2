{%- if description.len()>0 ~%}
{{description | rust_doc(0)}}
{%- endif %}
{%- if derivations.len()>0 ~%}
#[derive({% for i in derivations %}{{ i }}, {% endfor %})]
{%~ endif -%}
pub struct {{ name }} {
{%- for field in fields %}
{% if field.description.len()>0 +%}
{{field.description | rust_doc(1)}}{% endif %}
{%- if field.annotations.len()>0 %}
    {% for i in field.annotations %}{{ i }}{% endfor -%}
{%- endif %}
    {{ field.modifier }} {{ field.name }}: {{ field.data_type }},{%- endfor %}
}